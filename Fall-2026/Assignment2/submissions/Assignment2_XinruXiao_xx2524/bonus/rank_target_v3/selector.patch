+    # --- Target and split ---
+    # The portfolio consumes a cross-sectional ordering, not a calibrated
+    # forecast of the market's absolute return.  Convert each matured forward
+    # return into its percentile within the same date and bucket.  Every row in
+    # a date stays in one temporal partition, so this uses no validation or
+    # inference observation to define a training date's target.
+    bdf = bdf.copy()
+    matured = bdf["y_return"].notna()
+    bdf.loc[matured, "y_target"] = (
+        bdf.loc[matured].groupby("datadate")["y_return"]
+        .rank(method="average", pct=True)
+    )
+    assert bdf.loc[matured, "y_target"].between(0.0, 1.0).all()
+    all_dates = sorted(bdf[bdf["y_target"].notna()]["datadate"].unique())
