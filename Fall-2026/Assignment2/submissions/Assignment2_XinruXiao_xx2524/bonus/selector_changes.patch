+def _fit_partition_features(reference, frames, feature_cols):
+    """Fit clipping and missing-value parameters on reference only."""
+    ref = reference[feature_cols].astype(float).replace([np.inf, -np.inf], np.nan)
+    med = ref.median().fillna(0.0)
+    clean = ref.fillna(med)
+    lo, hi = clean.quantile(.01), clean.quantile(.99)
+    return [frame[feature_cols].astype(float).replace([np.inf, -np.inf], np.nan)
+            .fillna(med).clip(lower=lo, upper=hi, axis=1).to_numpy(dtype=float)
+            for frame in frames]
+
