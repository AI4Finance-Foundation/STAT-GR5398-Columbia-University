+def _trend_efficiency(frame: pd.DataFrame) -> pd.Series:
+    """Signed path efficiency over four consecutive quarterly price changes.
+
+    The caller sorts by ticker and date and applies the monthly as-of price cap.
+    A zero encodes either no net trend or insufficient valid observations.
+    """
+    symbols = frame["tic"]
+    quarters = pd.to_datetime(frame["datadate"]).dt.to_period("Q").astype("int64")
+    consecutive = quarters.groupby(symbols).diff().eq(1)
+    price = frame["trade_price"].where(frame["trade_price"] > 0)
+    change = np.log(price).groupby(symbols).diff().where(consecutive)
+    net = change.groupby(symbols).rolling(4, min_periods=4).sum().droplevel(0)
+    path = change.abs().groupby(symbols).rolling(4, min_periods=4).sum().droplevel(0)
+    return net.div(path.where(path > 0)).fillna(0.0).clip(-1.0, 1.0).reindex(frame.index)
+
 
