+def get_enhanced_company_news(ticker: str, api_key: str, days_back: int = 5,
+                              limit: int = 50) -> Dict[str, Any]:
+    """
+    Enhanced company news retrieval.
+
+    Primary source:
+        Financial Modeling Prep (FMP)
+
+    Fallback source:
+        Google News RSS
+
+    The fallback is used when the FMP endpoint is unavailable,
+    restricted by subscription, or returns no articles.
+    """
+    import requests
+    import xml.etree.ElementTree as ET
+
+    from datetime import datetime, timedelta
+    from email.utils import parsedate_to_datetime
+    from urllib.parse import quote_plus
+
+    end_date = datetime.now()
+    start_date = end_date - timedelta(days=days_back)
+
+    from_date = start_date.strftime("%Y-%m-%d")
+    to_date = end_date.strftime("%Y-%m-%d")
+
+    raw_news = []
+
+    # ---------------------------------------------------------
+    # 1. Try FMP first
+    # ---------------------------------------------------------
+    try:
+        url = "https://financialmodelingprep.com/stable/news/stock"
+
+        params = {
+            "symbols": ticker,
+            "from": from_date,
+            "to": to_date,
+            "limit": limit,
+            "apikey": api_key
+        }
+
+        logger.info(f"Fetching enhanced news for {ticker} from FMP...")
+
+        response = requests.get(url, params=params, timeout=15)
+        response.raise_for_status()
+
+        fmp_news = response.json()
+
+        if isinstance(fmp_news, list) and fmp_news:
+            raw_news = fmp_news
+            logger.info(
+                f"Retrieved {len(raw_news)} articles for {ticker} from FMP"
+            )
+        else:
+            logger.warning(
+                f"FMP returned no news for {ticker}; trying Google News fallback."
+            )
+
+    except Exception as e:
+        logger.warning(
+            f"FMP news unavailable for {ticker}: {e}. "
+            f"Trying Google News fallback."
+        )
+
+    # ---------------------------------------------------------
+    # 2. Google News RSS fallback
+    # ---------------------------------------------------------
+    if not raw_news:
+        try:
+            query = quote_plus(f"{ticker} stock when:{days_back}d")
+
+            rss_url = (
+                "https://news.google.com/rss/search?"
+                f"q={query}&hl=en-US&gl=US&ceid=US:en"
+            )
+
+            logger.info(
+                f"Fetching fallback news for {ticker} from Google News RSS..."
+            )
+
+            rss_response = requests.get(
+                rss_url,
+                timeout=15,
+                headers={
+                    "User-Agent": "Mozilla/5.0"
+                }
+            )
+
+            rss_response.raise_for_status()
+
+            root = ET.fromstring(rss_response.content)
+
+            fallback_news = []
+
+            for item in root.findall(".//item")[:limit]:
+                title = item.findtext("title", default="")
+                link = item.findtext("link", default="")
+                description = item.findtext("description", default="")
+                pub_date_raw = item.findtext("pubDate", default="")
+
+                source_element = item.find("source")
+                site = (
+                    source_element.text
+                    if source_element is not None
+                    and source_element.text
+                    else "Google News"
+                )
+
+                # Convert RSS date to the format expected by NewsIntegrator
+                published_date = ""
+
+                if pub_date_raw:
+                    try:
+                        parsed_date = parsedate_to_datetime(pub_date_raw)
+
+                        if parsed_date.tzinfo is not None:
+                            parsed_date = parsed_date.astimezone().replace(
+                                tzinfo=None
+                            )
+
+                        published_date = parsed_date.strftime(
+                            "%Y-%m-%d %H:%M:%S"
+                        )
+
+                    except Exception:
+                        published_date = pub_date_raw
+
+                fallback_news.append(
+                    {
+                        "symbol": ticker,
+                        "title": title,
+                        "text": description,
+                        "publishedDate": published_date,
+                        "site": site,
+                        "url": link
+                    }
+                )
+
+            raw_news = fallback_news
+
+            logger.info(
+                f"Retrieved {len(raw_news)} fallback articles "
+                f"for {ticker} from Google News."
+            )
+
+        except Exception as e:
+            logger.error(
+                f"Google News fallback also failed for {ticker}: {e}"
+            )
+            raw_news = []
+
+    # ---------------------------------------------------------
+    # 3. No news available from either source
+    # ---------------------------------------------------------
+    if not raw_news:
+        return {
+            "ticker": ticker,
+            "articles": [],
+            "summary": f"No recent news found for {ticker}.",
+            "categorized": {},
+            "sentiment_overview": {
+                "positive": 0,
+                "negative": 0,
+                "neutral": 0
+            },
+            "high_impact": []
+        }
+
+    # ---------------------------------------------------------
+    # 4. Run existing NewsIntegrator pipeline
+    # ---------------------------------------------------------
+    integrator = NewsIntegrator(ticker, api_key)
+
+    integrator.set_news_data(raw_news)
+    integrator.process_news(days_back)
+
+    categorized = integrator.get_news_by_category()
+    summary = integrator.generate_news_summary()
+
+    sentiments = [a.sentiment for a in integrator.articles]
+
+    return {
+        "ticker": ticker,
+
+        "articles": integrator.get_news_for_catalyst_analysis(),
+
+        "summary": summary,
+
+        "categorized": {
+            k: [
+                {
+                    "title": a.title,
+                    "sentiment": a.sentiment,
+                    "importance": a.importance
+                }
+                for a in v
+            ]
+            for k, v in categorized.items()
+        },
+
+        "sentiment_overview": {
+            "positive": sentiments.count("positive"),
+            "negative": sentiments.count("negative"),
+            "neutral": sentiments.count("neutral")
+        },
+
+        "high_impact": [
+            {
+                "title": a.title,
+                "category": a.category,
+                "sentiment": a.sentiment
+            }
+            for a in integrator.get_high_impact_news()
+        ]
+    }
 
