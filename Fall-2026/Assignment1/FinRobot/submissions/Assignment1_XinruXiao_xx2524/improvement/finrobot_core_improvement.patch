+    def _derive_rating_pdf(share_price, target_price, api_rating):
+        """
+        Preserve API analyst rating when available.
+        Derive a fallback rating only when API rating is unavailable.
+        """
+
+        if api_rating:
+            rating_text = str(api_rating).strip()
+            if rating_text and rating_text.lower() not in {
+                "n/a",
+                "na",
+                "none",
+                "null"
+            }:
+                return rating_text
+
+        try:
+            price = float(
+                str(share_price)
+                .replace('$', '')
+                .replace(',', '')
+            )
+            target = float(
+                str(target_price)
+                .replace('$', '')
+                .replace(',', '')
+            )
+
+            if price <= 0:
+                return 'N/A'
+
+            upside = (target - price) / price
+
+            if upside >= 0.15:
