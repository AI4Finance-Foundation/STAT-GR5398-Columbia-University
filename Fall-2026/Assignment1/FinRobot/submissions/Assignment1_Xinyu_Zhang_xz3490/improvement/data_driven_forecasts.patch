+def _historical_median_forecasts(df_historical: pd.DataFrame, forecast_config: dict) -> pd.DataFrame:
+    actual_years = sorted(col for col in df_historical.columns
+                          if isinstance(col, str) and col[:-1].isdigit() and col.endswith('A'))
+    years = [int(col[:-1]) for col in actual_years]
+    if len(years) < 3 or any(right - left != 1 for left, right in zip(years, years[1:])):
+        raise ValueError('Historical-median forecasts require at least three consecutive annual periods.')
+    df = df_historical[['metrics'] + actual_years].copy().astype('object')
+    if df['metrics'].duplicated().any():
+        raise ValueError('Financial metrics must have unique row names.')
+
+    def numbers(metric):
+        row = df.loc[df['metrics'] == metric, actual_years]
+        if row.empty:
+            raise ValueError('Missing financial metric: ' + metric)
+        return np.asarray([float(str(value).replace(',', '')) if pd.notna(value) else np.nan
+                           for value in row.iloc[0]], dtype=float)
+
+    revenue = numbers('Revenue')
+    if not np.isfinite(revenue).all() or (revenue <= 0).any():
+        raise ValueError('Historical revenue must be finite and positive.')
+    lookback = int(forecast_config.get('lookback', 3))
+    horizon = int(forecast_config.get('projection_years', 3))
+    floor = float(forecast_config.get('growth_floor', -0.25))
+    cap = float(forecast_config.get('growth_cap', 0.50))
+    anchor = float(forecast_config.get('growth_anchor', 0.05))
+    decay = float(forecast_config.get('growth_decay', 0.50))
+    if lookback < 1 or horizon < 1 or not (-1 < floor <= anchor <= cap) or not (0 <= decay <= 1):
+        raise ValueError('Invalid forecast settings.')
+    growth = np.diff(revenue) / revenue[:-1]
+    historical_growth = float(np.median(growth[-lookback:]))
+    first_growth = float(np.clip(historical_growth, floor, cap))
+    margins = {}
+    for metric in ['Contribution Profit', 'SG&A', 'EBITDA']:
+        values = numbers(metric)[-lookback:] / revenue[-lookback:]
+        if not np.isfinite(values).all():
+            raise ValueError('Missing historical values for ' + metric)
+        margins[metric] = float(np.median(values))
+    base_eps = numbers('EPS')[-1]
+    base_pe = numbers('PE Ratio')[-1]
+    implied_price = base_eps * base_pe
+    current_revenue = revenue[-1]
+    forecasts = {}
+    for offset in range(horizon):
+        year = f'{years[-1] + offset + 1}E'
+        rate = anchor + (first_growth - anchor) * decay ** offset
+        forecasts[year] = rate
+        current_revenue *= 1 + rate
+        eps = base_eps * current_revenue / revenue[-1]
+        values = {
+            'Revenue': round(current_revenue, 2),
+            'Cost of Operations': round(current_revenue * (1 - margins['Contribution Profit']), 2),
+            'SG&A': round(current_revenue * margins['SG&A'], 2),
+            'Contribution Profit': round(current_revenue * margins['Contribution Profit'], 2),
+            'Contribution Margin': f"{margins['Contribution Profit'] * 100:.1f}%",
+            'EBITDA': round(current_revenue * margins['EBITDA'], 2),
+            'EBITDA Margin': f"{margins['EBITDA'] * 100:.1f}%",
+            'SG&A Margin': f"{margins['SG&A'] * 100:.1f}%",
+            'Revenue Growth': f'{rate * 100:.1f}%',
+            'EPS': round(eps, 2) if np.isfinite(eps) else None,
+            'PE Ratio': round(implied_price / eps, 1)
+                        if np.isfinite(implied_price) and implied_price > 0 and eps > 0 else None,
+        }
+        df[year] = df['metrics'].map(values)
+    df['Historical CAGR'] = 'N/A'
+    cagr = (revenue[-1] / revenue[0]) ** (1 / (years[-1] - years[0])) - 1
+    df.loc[df['metrics'] == 'Revenue', 'Historical CAGR'] = f'{cagr * 100:.1f}%'
+    df.attrs['forecast_metadata'] = {
+        'forecast_method': 'historical_median', 'revenue_base_year': actual_years[-1],
+        'revenue_growth_assumptions': forecasts, 'lookback': lookback,
+        'projection_years': horizon, 'growth_floor': floor, 'growth_cap': cap,
+        'growth_anchor': anchor, 'growth_decay': decay,
+        'historical_growth_median': historical_growth,
+        'gross_margin': margins['Contribution Profit'], 'sga_margin': margins['SG&A'],
+        'ebitda_margin': margins['EBITDA'],
+        'margin_improvement': {'Contribution Margin': 0.0, 'EBITDA Margin': 0.0},
+        'sga_margin_change': 0.0,
+        'eps_assumption': 'Latest net margin and share count remain constant.',
+        'pe_assumption': 'Last actual fiscal-year implied price remains constant; losses have no P/E.',
+    }
+    return df
