+def _financial_frame(endpoint, ticker, api_key, period="annual", limit=5):
+    """Convert Stable records to the V1 pipeline's fiscal-year DataFrame."""
+    try:
+        records = _fmp_fetch(endpoint, ticker, api_key, period=period, limit=limit)
+        if not records:
+            print(f"No {endpoint} data from FMP for {ticker}.")
+            return None
+        df = pd.DataFrame(records)
+        df["date"] = pd.to_datetime(df["date"])
+        fiscal = df.get("fiscalYear", df.get("calendarYear", df["date"].dt.year))
+        df["year"] = pd.to_numeric(fiscal, errors="coerce").fillna(df["date"].dt.year).astype(int)
