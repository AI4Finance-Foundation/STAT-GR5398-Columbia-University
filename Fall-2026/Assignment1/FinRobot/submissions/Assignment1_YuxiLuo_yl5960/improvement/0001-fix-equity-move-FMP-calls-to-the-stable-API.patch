+def _fmp_get(endpoint: str, api_key: str, **params):
+    """GETs an FMP /stable/ endpoint and returns the decoded JSON.
+
+    Errors are re-raised without the request URL: requests puts the full URL,
+    query string included, into its exception messages, and the query string
+    carries the API key.
+    """
+    params["apikey"] = api_key
+    try:
+        response = requests.get(f"{FMP_BASE_URL}/{endpoint}", params=params, timeout=30)
+    except requests.exceptions.RequestException as e:
+        raise requests.exceptions.RequestException(str(e).replace(api_key, "***")) from None
+    if not response.ok:
+        raise requests.exceptions.HTTPError(
+            f"FMP /stable/{endpoint} returned {response.status_code}: {response.text[:200].strip()}"
+        )
+    data = response.json()
+    if isinstance(data, dict) and "Error Message" in data:
+        raise requests.exceptions.HTTPError(f"FMP /stable/{endpoint}: {data['Error Message']}")
+    return data
+
+
+def _stable_period(period: str) -> str:
+    """Maps the CLI's 'quarterly' to the 'quarter' value FMP expects."""
+    return "quarter" if period in ("quarter", "quarterly") else period
+
+
+def _add_legacy_aliases(df: pd.DataFrame, aliases: dict) -> pd.DataFrame:
+    for legacy, stable in aliases.items():
+        if legacy not in df.columns and stable in df.columns:
+            df[legacy] = df[stable]
+    return df
 
