@@ -0,0 +1,99 @@
+#!/usr/bin/env python
+# coding: utf-8
+"""Verifier for generated report sections.
+
+Runs after a section is written. It is given the section and exactly the data its writer was given, finds the
+sentences whose figures, periods or sources that data contradicts, and replaces them with minimal corrections.
+
+Corrections are applied by exact sentence replacement, so nothing else in the section can change. Statements the
+data neither supports nor contradicts (background knowledge) are left in place and listed as unverified: removing
+them would empty sections such as the company overview, whose prompt asks for exactly that kind of content, so they
+are surfaced for the reader instead.
+"""
+
+from typing import List, Literal, Optional, Tuple
+
+from openai import OpenAI
+from pydantic import BaseModel
+
+VERIFIER_INSTRUCTIONS = """You fact-check one section of an equity research report against DATA, the only information \
+its writer had.
+
+Go through SECTION sentence by sentence. For every figure in a sentence, first find the DATA cell it comes from and \
+note whether that cell is reported (a column ending in A, or a historical peer value) or a forecast (a column ending \
+in E, or the projected peer year). Then check the sentence's wording against that. A reported figure must be described \
+as reported or achieved, in the past tense: "projected", "expected", "estimated", "forecast", "guidance", "outlook" \
+or an "E" label attached to it is an error even if every number is right, and removing a false source such as \
+"consensus" does not fix it. A figure that matches DATA after rounding to the precision written is correct; do not \
+change it.
+
+A sentence needs a correction when:
+- a reported figure (a column ending in A, or a historical peer value) is presented as projected, expected, \
+estimated, forecast or guidance, or a forecast figure (a column ending in E, or the projected peer year) is presented \
+as reported or achieved;
+- a figure is attached to the wrong year, or carries the wrong year label (e.g. "2025E" for a reported 2025 value);
+- the CAGR is attributed to any period other than the one DATA gives;
+- a number, direction or comparison differs from DATA, or a quantifier ("doubled", "each year", "consistently", \
+"far ahead") is not borne out by the numbers;
+- it cites guidance, consensus, analysts or news that DATA does not contain.
+
+For each such sentence return the original sentence copied character for character from SECTION, the problem, and a \
+corrected sentence that fixes only that problem, otherwise keeps the writer's wording, and adds nothing that is not \
+in DATA. If a sentence cannot be corrected without inventing information, drop the unsupported part; return an empty \
+corrected sentence only if nothing true is left.
+
+Separately, list the sentences whose claims DATA does not cover at all (company history, products, strategy, market \
+position, regulation, competitors' plans). Do not change them.
+
+Leave opinions, recommendations and sentences consistent with DATA untouched."""
+
+
+class Correction(BaseModel):
+    original: str
+    problem: Literal["status", "period", "cagr_period", "value_or_comparison", "quantifier", "invented_source"]
+    explanation: str
+    corrected: str
+
+
+class VerifierOutput(BaseModel):
+    corrections: List[Correction]
+    unverified: List[str]
+
+
+def verify_section(text: str, section: str, evidence: str, api_key: str, base_url: Optional[str] = None,
+                   model: str = "gpt-4.1-mini", client: Optional[OpenAI] = None) -> Tuple[str, dict]:
+    """Returns (verified text, log entry). On any error the original text is returned unchanged."""
+    log = {"section": section, "model": model, "corrections": [], "not_applied": [], "unverified": []}
+    try:
+        if client is None:
+            client_kwargs = {"api_key": api_key, "max_retries": 5}
+            if base_url:
+                client_kwargs["base_url"] = base_url
+            client = OpenAI(**client_kwargs)
+        resp = client.chat.completions.parse(
+            model=model,
+            temperature=0,
+            response_format=VerifierOutput,
+            messages=[
+                {"role": "system", "content": VERIFIER_INSTRUCTIONS},
+                {"role": "user", "content": f"DATA\n<<<\n{evidence}\n>>>\n\nSECTION ({section})\n<<<\n{text}\n>>>"},
+            ],
+        )
+        result = resp.choices[0].message.parsed
+        log["usage"] = {"input_tokens": resp.usage.prompt_tokens, "output_tokens": resp.usage.completion_tokens}
+    except Exception as e:  # never block report generation on the verifier
+        log["error"] = str(e)[:300]
+        return text, log
+
+    revised = text
+    for c in result.corrections:
+        if c.original and c.original in revised and c.corrected != c.original:
+            revised = revised.replace(c.original, c.corrected, 1)
+            log["corrections"].append(c.model_dump())
+        else:
+            # Not found verbatim (or no change): never edit by guesswork.
+            log["not_applied"].append(c.model_dump())
+    log["unverified"] = result.unverified
+    revised = "\n".join(" ".join(line.split()) if line.strip() else "" for line in revised.split("\n")) \
+        if revised != text else revised
+    return revised, log
