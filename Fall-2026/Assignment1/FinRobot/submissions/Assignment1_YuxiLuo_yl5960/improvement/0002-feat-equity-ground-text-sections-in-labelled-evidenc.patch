+"""Tests for the evidence notes and the section verifier (no network: the OpenAI client is faked)."""
+import os
+import sys
+from types import SimpleNamespace
+
+import pandas as pd
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "src"))
+
+from modules.claim_verifier import Correction, VerifierOutput, verify_section  # noqa: E402
+from modules.text_generator_agents import _prepare_user_prompt  # noqa: E402
+
+
+def _metrics():
+    return pd.DataFrame({
+        "metrics": ["Revenue", "EBITDA", "Revenue Growth"],
+        "2025A": [100.0, 40.0, "10.0%"],
+        "2026A": [120.0, 50.0, "20.0%"],
+        "2027E": [126.0, 53.0, "5.0%"],
+        "2028E": [133.6, 56.0, "6.0%"],
+        "CAGR": ["20.0%", "N/A", "N/A"],
+    }).astype(object)
+
+
+def _data():
+    peers = pd.DataFrame({"AAA": [40.0, 50.0, 60.0], "BBB": [10.0, 12.0, 14.0]}, index=[2025, 2026, 2027])
+    return {"financial_metrics": _metrics(), "peer_ebitda": peers, "peer_ev_ebitda": peers / 2,
+            "report_date": "2026-10-10"}
+
+
+def test_notes_state_date_status_and_cagr_period():
+    prompt = _prepare_user_prompt(_data(), "investment_overview", "Acme", "AAA")
+    assert "Report date: 2026-10-10." in prompt
+    assert "2025A to 2026A are reported" in prompt
+    assert "2027E to 2028E are this pipeline's own forecast" in prompt
+    assert "2027E: 5.0%" in prompt
+    assert "revenue CAGR from 2025A to 2026A" in prompt
+    assert "the last year (2027) is this pipeline's projection" in prompt
+    assert "no company guidance and no analyst consensus" in prompt
+
+
+def test_annotate_false_reproduces_the_original_prompt():
+    prompt = _prepare_user_prompt(_data(), "investment_overview", "Acme", "AAA", annotate=False)
+    assert "How to read this data" not in prompt
+    assert prompt.startswith("Company: Acme (AAA)\n\nFinancial Metrics:")
+
+
+class _FakeClient:
+    def __init__(self, output=None, error=None):
+        self._output, self._error = output, error
+        self.chat = SimpleNamespace(completions=SimpleNamespace(parse=self._parse))
+
+    def _parse(self, **kwargs):
+        if self._error:
+            raise self._error
+        usage = SimpleNamespace(prompt_tokens=10, completion_tokens=5)
+        return SimpleNamespace(choices=[SimpleNamespace(message=SimpleNamespace(parsed=self._output))], usage=usage)
+
+
+TEXT = "Revenue reached $120 in 2026. Guidance points to $126 in 2027. The brand is iconic."
+
+
+def test_verifier_replaces_only_matching_sentences_and_logs_everything():
+    out = VerifierOutput(
+        corrections=[
+            Correction(original="Guidance points to $126 in 2027.", problem="invented_source",
+                       explanation="no guidance in DATA", corrected="The pipeline forecasts $126 for 2027E."),
+            Correction(original="A sentence that is not in the text.", problem="status",
+                       explanation="hallucinated", corrected="Something else."),
+        ],
+        unverified=["The brand is iconic."],
+    )
+    revised, log = verify_section(TEXT, "investment_overview", "DATA", api_key=None, client=_FakeClient(out))
+    assert revised == "Revenue reached $120 in 2026. The pipeline forecasts $126 for 2027E. The brand is iconic."
+    assert len(log["corrections"]) == 1 and len(log["not_applied"]) == 1
+    assert log["unverified"] == ["The brand is iconic."]
+
+
+def test_verifier_returns_the_original_text_on_error():
+    revised, log = verify_section(TEXT, "risks", "DATA", api_key=None, client=_FakeClient(error=RuntimeError("boom")))
+    assert revised == TEXT
+    assert "boom" in log["error"]
+
+
+def test_forecast_labels_follow_the_base_year():
+    # mirrors generate_financial_analysis.py: labels are FY+1..FY+3 of the latest reported year
+    latest_year = "2026A"
+    base_year = int(latest_year[:4])
+    assert [f"{base_year + i}E" for i in (1, 2, 3)] == ["2027E", "2028E", "2029E"]
