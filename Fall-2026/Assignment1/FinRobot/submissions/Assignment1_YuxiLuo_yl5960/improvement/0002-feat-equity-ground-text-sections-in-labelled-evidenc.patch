+_ACTUAL_COL = re.compile(r"^(\d{4})A$")
+_FORECAST_COL = re.compile(r"^(\d{4})E$")
+
+
+def _evidence_notes(data: Dict, prompt_type: str) -> str:
+    """Says which figures are reported, which are this pipeline's own forecast, and as of when.
+
+    Without this the tables do not say it, and the sections routinely called reported results
+    "projected" or "guidance" and attached the historical CAGR to the forecast years.
+    """
+    fm = data.get('financial_metrics')
+    lines = []
+    if data.get('report_date'):
+        lines.append(f"Report date: {data['report_date']}.")
+    if fm is not None and not fm.empty:
+        actual = sorted(c for c in fm.columns if isinstance(c, str) and _ACTUAL_COL.match(c))
+        forecast = sorted(c for c in fm.columns if isinstance(c, str) and _FORECAST_COL.match(c))
+        if actual:
+            lines.append(f"- Financial Metrics: {actual[0]} to {actual[-1]} are reported fiscal-year results; "
+                         f"the latest reported fiscal year is FY{actual[-1][:4]}.")
+        if forecast:
+            growth = ""
+            rows = fm[fm['metrics'] == 'Revenue Growth'] if 'metrics' in fm.columns else None
+            if rows is not None and not rows.empty:
+                growth = " (assumed revenue growth " + ", ".join(f"{c}: {rows.iloc[0][c]}" for c in forecast) + ")"
+            lines.append(f"- {forecast[0]} to {forecast[-1]} are this pipeline's own forecast, built from fixed "
+                         f"assumptions{growth}. They are not company guidance and not analyst consensus.")
+        if 'CAGR' in fm.columns and len(actual) > 1:
+            lines.append(f"- CAGR is the revenue CAGR from {actual[0]} to {actual[-1]} (reported years only).")
+    peer_ebitda = data.get('peer_ebitda')
+    if peer_ebitda is not None and not peer_ebitda.empty:
+        lines.append(f"- Peer EBITDA Comparison: the last year ({int(peer_ebitda.index.max())}) is this pipeline's "
+                     "projection from each company's average historical growth; earlier years are reported.")
+    if data.get('peer_ev_ebitda') is not None and not data['peer_ev_ebitda'].empty:
+        lines.append("- Peer EV/EBITDA Comparison: all values are historical.")
+    if peer_ebitda is not None or data.get('peer_ev_ebitda') is not None:
+        lines.append("- In the peer tables a year is the calendar year in which that company's fiscal year ends.")
+    lines.append("- 'Contribution Margin' is gross margin, (revenue - cost of revenue) / revenue. 'SG&A' excludes R&D.")
+    has_news = prompt_type == "news_summary" and data.get('company_news')
+    lines.append("- The data contains no company guidance and no analyst consensus"
+                 + ("." if has_news else ", and no news."))
+    lines.append("Describe reported figures as reported and forecast figures as this pipeline's forecast, "
+                 "and attach every figure to the period it belongs to.")
+    return "How to read this data:\n" + "\n".join(lines) + "\n\n"
+
+
+def _prepare_user_prompt(data: Dict, prompt_type: str, company_name: str, company_ticker: str,
+                         annotate: bool = True) -> str:
