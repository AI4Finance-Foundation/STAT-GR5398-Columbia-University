+def generate_text_section(data, prompt_type, api_key, company_name, company_ticker,
+                          base_url=None, model=None):
+    """Use the upstream typed specialist team required by the course.
+
+    Fail closed on provider errors instead of saving plausible fallback text.
+    """
+    import asyncio
+    import os
+    from openai import AsyncOpenAI
+    from agents import set_default_openai_client, set_tracing_disabled
+    from .equity_agents.agent_manager import EquityResearchAgentManager
+    if not api_key:
+        raise RuntimeError("OpenAI key missing; no synthetic fallback text generated")
+    os.environ['OPENAI_MODEL_NAME'] = model or 'gpt-4.1'
+    set_tracing_disabled(True)
+    async def run():
+        kwargs = {'api_key': api_key}
+        if base_url:
+            kwargs['base_url'] = base_url
+        async with AsyncOpenAI(**kwargs) as client:
+            set_default_openai_client(client, use_for_tracing=False)
+            return await EquityResearchAgentManager().generate_text_section(
+                data, prompt_type, company_name, company_ticker)
+    return asyncio.run(run())
+
