+def normalize_forecast_config(df_historical: pd.DataFrame, forecast_config: dict) -> dict:
+    """Map the legacy CLI growth slots to years strictly after the last actual.
+
+    The 2025/2026/2027 CLI names are horizon slots, not valid date labels once
+    newer actuals arrive. Preserve their ordered values and all financial
+    formulas; record the mapping so the compatibility change is auditable.
+    Historical backtests must first truncate the input to the information set
+    at the forecast origin. An older base with newer actuals is rejected.
+    """
+    actual_years = sorted(
+        int(col[:-1]) for col in df_historical.columns
+        if isinstance(col, str) and re.fullmatch(r"\d{4}A", col)
+    )
+    if not actual_years:
+        raise ValueError("Forecasting requires at least one annual actual column (YYYYA).")
+    latest = f"{actual_years[-1]}A"
+    if forecast_config.get("revenue_base_year", latest) != latest:
+        raise ValueError("Forecast base must be the latest actual; truncate later actuals for backtests.")
+    config = deepcopy(forecast_config)
+    original = config.get("revenue_growth_assumptions", {})
+    if not original:
+        raise ValueError("At least one explicit revenue growth assumption is required.")
+    if any(not re.fullmatch(r"\d{4}E", str(label)) for label in original):
+        raise ValueError("Revenue growth labels must have the form YYYYE.")
+    ordered = sorted(original.items(), key=lambda item: int(item[0][:-1]))
+    mapping = {old: f"{actual_years[-1] + index}E"
+               for index, (old, _) in enumerate(ordered, 1)}
+    config["revenue_base_year"] = latest
+    config["revenue_growth_assumptions"] = {mapping[old]: value for old, value in ordered}
+    config.setdefault("forecast_label_mapping", mapping)
+    config["forecast_origin"] = latest
+    config["forecast_basis"] = "annual periods after latest observed actual; not calendar-year projections"
+    return config
 
 def clean_financial_number(x):
     """Cleans a string representing a financial number into a float."""
