+        ('catalyst_analysis', 'Catalyst analysis'),
+        ('enhanced_news', 'Enhanced news'),
+    ):
+        if data.get(key):
+            payload = escape(json.dumps(data[key], indent=2, ensure_ascii=False, default=str))
+            body.append(f'<section><h2>{label}</h2><pre class="evidence">{payload}</pre></section>')
+    body.append('<footer>Generated from frozen inputs. Narrative verification status and quantitative limitations '
+                'are recorded in the accompanying research audit.</footer>')
+    css = '''body{font-family:Arial,sans-serif;color:#142237;background:#fff;max-width:1080px;margin:40px auto;padding:0 28px;line-height:1.6}
