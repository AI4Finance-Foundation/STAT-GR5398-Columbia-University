+        table_html = _re.sub(r'(?<=>)\s*NaN\s*(?=</t[dh]>)', 'N/A', str(data.get(key, '<p>N/A</p>')))
+        body.append(f'<section><h2>{label}</h2><p class="missing">N/A denotes missing or inapplicable data, never zero.</p><div class="table-wrap">{table_html}</div></section>')
+    asset_dir = Path(output_dir) / 'assets'
+    asset_dir.mkdir(parents=True, exist_ok=True)
+    for key, label in (
+        ('revenue_chart_path', 'Revenue and EBITDA'),
+        ('eps_pe_chart_path', 'EPS and P/E'),
+        ('ev_ebitda_chart_path', 'Peer EV/EBITDA'),
+    ):
+        source = Path(data[key]) if data.get(key) else None
+        if source is not None and source.is_file():
+            # Content-based names prevent collisions and make the report portable.
+            digest = hashlib.sha256(source.read_bytes()).hexdigest()[:16]
+            destination = asset_dir / f'{key}_{digest}{source.suffix}'
+            if source.resolve() != destination.resolve():
+                shutil.copyfile(source, destination)
+            body.append(f'<figure><img src="assets/{escape(destination.name)}" alt="{label}"><figcaption>{label}</figcaption></figure>')
+        else:
+            body.append(f'<p class="missing">Optional chart unavailable: {label}.</p>')
+    for key, label in (
