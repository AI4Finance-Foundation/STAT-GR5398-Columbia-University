+    .eyebrow{letter-spacing:.08em;text-transform:uppercase;color:#49667b}section{padding:24px 0;border-bottom:1px solid #dce4e9}
+    .agent-text{white-space:pre-wrap;overflow-wrap:anywhere}.metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
+    dt{font-size:12px;color:#526574}dd{margin:4px 0;font-weight:bold}.table-wrap{overflow-x:auto}table{border-collapse:collapse;font-size:12px;width:100%}
+    th,td{padding:6px 9px;border:1px solid #cbd5de;text-align:right}th{background:#eef3f7}figure{margin:26px 0}img{max-width:100%;height:auto}
+    figcaption,.missing,footer{font-size:12px;color:#526574}.evidence{white-space:pre-wrap;overflow-wrap:anywhere;font-size:11px}
+    @media(max-width:640px){.metrics{grid-template-columns:1fr}body{padding:0 16px}}@media print{body{margin:0;max-width:none;font-size:10pt}h2{break-after:avoid}figure{break-inside:avoid}.table-wrap{overflow:visible}table{font-size:8pt}@page{size:A4;margin:16mm}}'''
+    return ('<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">'
